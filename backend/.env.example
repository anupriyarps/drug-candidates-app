APP_NAME=Drug Candidates API
APP_VERSION=0.1.0
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=drug_candidates
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace-with-a-local-postgres-password
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOG_LEVEL=INFO
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_LIFETIME_SECONDS=900
JWT_REFRESH_LIFETIME_SECONDS=604800
AUTH_COOKIE_SECURE=false
CACHE_ENABLED=false
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60
REDIS_SOCKET_TIMEOUT_SECONDS=0.2
